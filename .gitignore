# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

.rokct/cache/
.dart_tool/
# Machine-local dependency overrides. `dart pub` merges pubspec_overrides.yaml
# over pubspec.yaml's dependency_overrides automatically, so dev-machine
# workarounds (e.g. the Windows firebase copies in .rokct/win_dev_overrides/)
# belong there - never in the tracked pubspec.yaml, which is what CI resolves.
pubspec_overrides.yaml
.rokct/win_dev_overrides/
# lib/ is generated by compose on every build - main.dart included - so
# none of it is tracked and a fresh checkout regenerates it. main.dart is
# no longer an exception: everything app-specific that used to be
# hand-written there now lives in manifest data (each SDK's app_routes /
# embedded_widgets / brand_hook, and host_routes in composer.json), which
# IS tracked and is the real source of truth.
lib/
# Installed by compose from lms_sdk's manifest `installs` (the SDK is the
# custodian of this test; it lands in test/ the same way lms_route_pages.dart
# lands in lib/) - not tracked here, same policy as the composed lib/ files.
# test/ itself stays tracked: widget_test.dart is host-owned.
test/onboarding_grade_slide_test.dart
pubspec.lock
.flutter-plugins*
# `android/` used to be a blanket ignore here. It never hid the android/ files
# already tracked in this repo - the composed android/ tree is committed and is
# authoritative - so the only thing it ever hid was NEW files, which is why
# adding the backup rule XML needed `git add -f`. Replaced with targeted rules
# in the shape the rest of the fleet uses (paas_driver, paas_manager). Build
# output is already covered by `build/` above and by `.gradle` in
# android/.gitignore.

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing material - never commit. CI materialises android/key.properties from
# the KEY_JKS / KEY_PASSWORD / ALIAS_PASSWORD secrets at build time, and the
# stock android/.gitignore ships `key.properties` commented out, so it stays
# ignored only because it is named here. Do not remove these lines.
key.properties
*.jks
**/*.jks
*.keystore
**/*.keystore

# Local machine config (also covered by android/.gitignore).
local.properties
ios/
# assets/ is deliberately NOT ignored: installed assets (splash/login
# backgrounds, team renders, ...) are tracked so the shell repo owns and can
# rebrand them. The SDK installer's hash-guard skips any asset a developer
# has modified (or that it has no record of installing), so rebranded files
# survive recompose.
analysis_options.yaml
flutter_native_splash.yaml
pubspec.yaml

# Python bytecode from running the .rokct compose/install scripts.
.rokct/__pycache__/
