{
  "name": "rokctapp_composer",
  "version": "1.0.0",
  "package_name": "supacharge",
  "description": "Configuration list of active SDKs for the Supacharge app",
  "sdks": [
    {
      "name": "base_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/dart",
      "ref": "main",
      "home_sdk": false,
      "_comment": "Shared kernel (replaces retired core_sdk); provides the app shell templates."
    },
    {
      "name": "lms_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/lms/dart",
      "ref": "main",
      "home_sdk": true,
      "_comment": "LMS domain SDK (2026-07 carve-out from agent_sdk/replay_sdk); owns the lesson-player experience and is Supacharge's home SDK."
    },
    {
      "name": "auth_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/auth/dart",
      "ref": "main"
    },
    {
      "name": "users_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/users/dart",
      "ref": "main"
    },
    {
      "name": "products_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/commerce",
      "path": "../commerce/products/dart",
      "ref": "main",
      "_comment": "Transitive dependency of users_sdk, not used directly by Supacharge features today."
    },
    {
      "name": "merchants_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/commerce",
      "path": "../commerce/merchants/dart",
      "ref": "main",
      "_comment": "Mutual dependency of products_sdk, not used directly by Supacharge features today."
    },
    {
      "name": "onboarding_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/onboarding/dart",
      "ref": "main"
    },
    {
      "name": "payments_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/payments/dart",
      "ref": "main"
    },
    {
      "name": "wallet_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/wallet/dart",
      "ref": "main",
      "_comment": "Transitive dependency of payments_sdk, not used directly by Supacharge features today."
    },
    {
      "name": "subscriptions_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/subscriptions/dart",
      "ref": "main"
    },
    {
      "name": "replay_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/replay/dart",
      "ref": "main"
    },
    {
      "name": "agent_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/agent/dart",
      "ref": "main",
      "home_sdk": false
    },
    {
      "name": "fav_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/fav/dart",
      "ref": "main",
      "_comment": "Used today for shop/product favoriting only. Subject-selection reuse (ADR-004 in decision_log.md) is still PENDING - do not assume subject selection works via fav_sdk until that redesign lands."
    },
    {
      "name": "comms_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/comms/dart",
      "ref": "main"
    },
    {
      "name": "productivity_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/productivity",
      "path": "../productivity/productivity/dart",
      "ref": "main"
    },
    {
      "name": "processing_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/productivity",
      "path": "../productivity/processing/dart",
      "ref": "main"
    }
  ],
  "host_routes": [],
  "_host_routes_comment": "The /onboarding-intro entry moved out 2026-08-09: onboarding_sdk now owns that route via its own manifest + templated onboarding_route_pages.dart (installed automatically, slides injected from each SDK's manifest 'onboarding_slides'), the same way auth_sdk owns its login/register/reset routes via its templated auth_route_pages.dart."
}