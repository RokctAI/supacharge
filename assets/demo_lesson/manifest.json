  "comprehension_check": {
    "cc1": {
      "id": "cc1",
      "question": "Explain why a quadratic equation must be in the standard form ($ax^2 + bx + c = 0$) before you begin factoring.",
      "expected_answer": "It must be set to zero so that after factoring, the zero-product property can be applied. The property only works if the product equals zero."
    },
    "cc3": {
      "id": "cc3",
      "question": "In your own words, describe how the zero-product property is used to find the final solutions of a factored quadratic equation.",
      "expected_answer": "Once the equation is factored into two binomials multiplied together and set to zero, the property allows us to set each individual binomial equal to zero and solve them as simple linear equations."
    }
